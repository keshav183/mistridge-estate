# Everything is optional for a local run: every secret below defaults to the demo value hello123.
# Copy to .env only if you want to change something.
PORT=4000
# Empty = embedded MongoDB stored in ./.data. Set to use your own MongoDB / Atlas.
MONGODB_URI=
JWT_SECRET=hello123
# Gemini API key for the enquiry router. hello123 = "no real key", so the built-in rules engine is used.
GEMINI_API_KEY=hello123
GEMINI_MODEL=gemini-2.5-flash
# Shared secret for the simulated WhatsApp/email webhook (header x-ingest-key)
INGEST_KEY=hello123
# Enquiries below this confidence go to the GM's Unsorted lane
AI_CONFIDENCE_THRESHOLD=0.6
# Password for the seeded demo staff accounts
SEED_PASSWORD=hello123
