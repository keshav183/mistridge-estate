# Copy to .env — never commit the real file.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mistridge
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=
# Only needed if the frontend is served from a different origin in dev
CLIENT_ORIGIN=http://localhost:5173
# Optional. Without it the enquiry router uses its built-in rules engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Shared secret for the simulated WhatsApp/email webhook (POST /api/enquiries/ingest)
INGEST_KEY=
# Enquiries below this confidence go to the GM's Unsorted lane
AI_CONFIDENCE_THRESHOLD=0.6
# Password given to demo accounts by `npm run seed`
SEED_PASSWORD=Demo@1234
