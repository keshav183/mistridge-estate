# Everything here is optional for a local run. Copy to .env to override.
PORT=4000
# Leave empty to use the embedded MongoDB (stored in ./.data). Set to use your own MongoDB / Atlas.
MONGODB_URI=
# Required in production (openssl rand -hex 32). In development a random one is generated.
JWT_SECRET=
# Optional. Without it the enquiry router uses its built-in rules engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Shared secret for the simulated WhatsApp/email webhook (header x-ingest-key)
INGEST_KEY=
# Enquiries below this confidence go to the GM's Unsorted lane
AI_CONFIDENCE_THRESHOLD=0.6
SEED_PASSWORD=Demo@1234
